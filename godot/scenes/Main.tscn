[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/Main.gd" id="1"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 32.0
offset_top = 32.0
offset_right = -32.0
offset_bottom = -32.0

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Panel/VBox"]
unique_name_in_owner = true
theme_override_font_sizes/font_size = 42
text = "Durak Arena"

[node name="SubtitleLabel" type="Label" parent="Panel/VBox"]
unique_name_in_owner = true
text = ""

[node name="LangRow" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2

[node name="UkButton" type="Button" parent="Panel/VBox/LangRow"]
text = "UKR"

[node name="EnButton" type="Button" parent="Panel/VBox/LangRow"]
text = "EN"

[node name="PlayersLabel" type="Label" parent="Panel/VBox"]
unique_name_in_owner = true
text = "Players: 6"

[node name="PlayersSlider" type="HSlider" parent="Panel/VBox"]
unique_name_in_owner = true
min_value = 2.0
max_value = 6.0
step = 1.0
value = 6.0

[node name="BotsCheck" type="CheckBox" parent="Panel/VBox"]
unique_name_in_owner = true
text = "Bots"
button_pressed = true

[node name="InviteCheck" type="CheckBox" parent="Panel/VBox"]
unique_name_in_owner = true
text = "Friend Invites"
button_pressed = true

[node name="FriendsOnlyCheck" type="CheckBox" parent="Panel/VBox"]
unique_name_in_owner = true
text = "Friends Only"

[node name="ButtonsRow" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2

[node name="CreateLobbyButton" type="Button" parent="Panel/VBox/ButtonsRow"]
unique_name_in_owner = true
text = "Create Lobby"

[node name="StartButton" type="Button" parent="Panel/VBox/ButtonsRow"]
unique_name_in_owner = true
text = "Start Game"

[node name="OutputText" type="RichTextLabel" parent="Panel/VBox"]
unique_name_in_owner = true
size_flags_vertical = 3
custom_minimum_size = Vector2(0, 360)

[connection signal="pressed" from="Panel/VBox/LangRow/UkButton" to="." method="_on_uk_button_pressed"]
[connection signal="pressed" from="Panel/VBox/LangRow/EnButton" to="." method="_on_en_button_pressed"]
[connection signal="value_changed" from="Panel/VBox/PlayersSlider" to="." method="_on_players_slider_value_changed"]
[connection signal="toggled" from="Panel/VBox/BotsCheck" to="." method="_on_bots_check_toggled"]
[connection signal="toggled" from="Panel/VBox/InviteCheck" to="." method="_on_invite_check_toggled"]
[connection signal="toggled" from="Panel/VBox/FriendsOnlyCheck" to="." method="_on_friends_only_check_toggled"]
[connection signal="pressed" from="Panel/VBox/ButtonsRow/CreateLobbyButton" to="." method="_on_create_lobby_button_pressed"]
[connection signal="pressed" from="Panel/VBox/ButtonsRow/StartButton" to="." method="_on_start_button_pressed"]
